APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# 本機開發可 true；正式上雲必須 APP_ENV=production 且 APP_DEBUG=false
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# 請與瀏覽器網址完全一致（含埠）。若使用 --port=8001，請寫 http://127.0.0.1:8001；不要用 localhost 開網頁卻在 .env 寫 127.0.0.1（或相反），否則 Filament／Livewire 可能異常。
# 正式環境請使用 https:// 網域，並啟用反向代理 TLS／HSTS。

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# 正式環境建議 warning 或 error
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kid_learn
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# 正式 HTTPS 建議 SESSION_ENCRYPT=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# 本機用 http://127.0.0.1:8001 時務必為 false；正式 HTTPS 必須為 true。
# APP_ENV=production 時程式會強制 secure cookie，並忽略 same_site=none。
SESSION_SECURE_COOKIE=false

# 家長 App Sanctum token 有效分鐘數（預設 60 天）。正式可依需求縮短。
SANCTUM_TOKEN_EXPIRATION_MINUTES=86400

# 瀏覽器 CORS 白名單（逗號分隔）。正式請改為實際 https 網域。
# production 會丟棄 * 與帶萬用字元的來源。
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:*,http://localhost:*

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email 驗證連結有效分鐘數（預設 60）
# AUTH_VERIFICATION_EXPIRE=60

# 正式環境請改 SMTP／SES 等；本機可用 log 於 storage/logs 查看驗證信內容
# MAIL_MAILER=smtp

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI 出題（後台 Filament「AI 出題」；未設定 key 時按鈕會失敗）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_QUESTION_MODEL=gpt-4o-mini
